# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region. When middleware cannot determine the user region from the request IP, this will be used instead.
NEXT_PUBLIC_DEFAULT_REGION=us

# Minio endpoint for image storage (optional)
# NEXT_PUBLIC_MINIO_ENDPOINT=bucket-production-eaeb.up.railway.app

# MeiliSearch Configuration
# The URL of your MeiliSearch instance (default: http://localhost:7700 or auto-configured on Railway)
NEXT_PUBLIC_SEARCH_ENDPOINT=http://localhost:7700

# Your MeiliSearch search key (auto-configured on Railway)
NEXT_PUBLIC_SEARCH_API_KEY=your_search_key_here

# The name of the index in MeiliSearch (matches backend configuration)
NEXT_PUBLIC_INDEX_NAME=products

# Analytics Integration
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Feature Toggles
ENABLE_MAINTENANCE_MODE=false
ENABLE_COMING_SOON=false

# Credentials for the maintenance/coming-soon bypass login (required if either
# feature toggle above is "true" — the login form fails closed without these,
# it does NOT fall back to a default).
COMING_SOON_USERNAME=
COMING_SOON_PASSWORD=

# Shared secret for the /api/revalidate on-demand ISR endpoint. Must match the
# REVALIDATE_SECRET set on the backend (see backend/.env.template) — the
# backend calls this endpoint whenever product/collection/category data
# changes, so the storefront's cache doesn't rely solely on the storefront's
# own mutations (cart/customer) plus an otherwise-infinite fetch-cache lifetime.
REVALIDATE_SECRET=

# Sentry error tracking (optional — client/server/edge init all no-op safely
# if these are unset). SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are typically the
# same value; NEXT_PUBLIC_ is required for the client-side init to see it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload sourcemaps at build time (readable stack traces in
# the Sentry UI) — build succeeds without these, sourcemap upload just no-ops.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

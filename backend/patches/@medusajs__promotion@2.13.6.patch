+// Cardle patch: compare UNIT prices, so a line with qty 2 of a cheap bag does
+// not outrank one dearer bag. Buy items: dearest first. Targets: cheapest first,
+// so "buy 2 get 1" always frees the cheapest bag(s).
+function unitPrice(i) {
+    return utils_1.MathBN.div(i.subtotal, utils_1.MathBN.max(i.quantity, 1));
+}
+function sortByUnitPriceDesc(a, b) {
+    return utils_1.MathBN.lt(unitPrice(a), unitPrice(b)) ? 1 : -1;
+}
+function sortByUnitPriceAsc(a, b) {
+    return utils_1.MathBN.gt(unitPrice(a), unitPrice(b)) ? 1 : -1;
+}
 function sortByPrice(a, b) {
